{
  "extends": "../tsconfig",
  "compilerOptions": {
    "strict": true,
    "customConditions": ["source"],
    "paths": {
      "@/example/*": ["./src/*"],
      "react-native-text-animations": ["../src/index.tsx"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
